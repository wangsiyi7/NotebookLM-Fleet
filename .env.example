HOST=127.0.0.1
PORT=8765
# Default directories (override with your own workspace / mounted Google Drive folder)
WORKSPACE_ROOT=..
DRIVE_HUB_ROOT=./data/NLM_Hub
DRIVE_LIBRARY_ROOT=./data/Drive_Library
# Starter master account email seeded on first run (editable in Web UI -> Accounts)
DEFAULT_MASTER_EMAIL=ultra-1@example.com
# Optional browser binary override (leave default or point to Chrome / Edge)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
SAFETY_BUFFER_PCT=10
POLL_INTERVAL_MIN=12
PYTHONUTF8=1
